# Copy to .env (never commit .env).
# From platform.youversion.com. A client app key by YouVersion's design; still kept out of git.
EXPO_PUBLIC_YOUVERSION_APP_KEY=
# Optional. Empty = on-device matcher only, and translation shows the copy-only fallback.
EXPO_PUBLIC_AI_RELAY_URL=
# Shows the "Judge panel" switch in Settings (set false for store builds).
EXPO_PUBLIC_SHOW_PANEL_TOGGLE=true
# development | preview | production
APP_VARIANT=development
