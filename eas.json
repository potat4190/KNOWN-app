{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_SHOW_PANEL_TOGGLE": "true" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "preview", "EXPO_PUBLIC_SHOW_PANEL_TOGGLE": "true" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production", "EXPO_PUBLIC_SHOW_PANEL_TOGGLE": "false" }
    }
  },
  "submit": { "production": {} }
}
