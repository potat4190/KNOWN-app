{
  "ruth": {
    "v": "16",
    "t": {
      "en": [
        "Under your wings",
        "I am safe."
      ],
      "zh": [
        "在你的翅膀下，",
        "我是安全的。"
      ],
      "ja": [
        "あなたの翼の下で、",
        "わたしは安らぐ。"
      ],
      "my": [
        "ကိုယ်တော့်အတောင်အောက်မှာ",
        "ကျွန်ုပ် လုံခြုံပါတယ်။"
      ],
      "ar": [
        "تحت جناحيك",
        "أنا في أمان."
      ]
    }
  },
  "neh": {
    "v": "4",
    "t": {
      "en": [
        "God of heaven,",
        "you hear me here."
      ],
      "zh": [
        "天上的神啊，",
        "你在这里也听见我。"
      ],
      "ja": [
        "天の神よ、",
        "ここでも聞いてくださる。"
      ],
      "my": [
        "ကောင်းကင်ဘုံရှိ ဘုရားသခင်၊",
        "ဒီနေရာမှာလည်း ကျွန်ုပ်ကို နားထောင်ပါတယ်။"
      ],
      "ar": [
        "يا إله السماء،",
        "أنت تسمعني هنا أيضًا."
      ]
    }
  },
  "ps142": {
    "v": "5",
    "t": {
      "en": [
        "You are my refuge,",
        "my place in this land."
      ],
      "zh": [
        "你是我的避难所，",
        "是我在这地上的归宿。"
      ],
      "ja": [
        "あなたはわたしの避け所、",
        "この地でのわたしの居場所。"
      ],
      "my": [
        "ကိုယ်တော်သည် ကျွန်ုပ်ခိုလှုံရာ၊",
        "ဒီမြေပေါ်မှာ ကျွန်ုပ်နေရာ ဖြစ်ပါတယ်။"
      ],
      "ar": [
        "أنت ملجأي،",
        "ومكاني في هذه الأرض."
      ]
    }
  },
  "hagar": {
    "v": "13",
    "t": {
      "en": [
        "You see me.",
        "You know my name."
      ],
      "zh": [
        "你看见我。",
        "你知道我的名字。"
      ],
      "ja": [
        "あなたはわたしを見ている。",
        "わたしの名を知っている。"
      ],
      "my": [
        "ကိုယ်တော် ကျွန်ုပ်ကို မြင်ပါတယ်။",
        "ကျွန်ုပ်နာမည်ကို သိပါတယ်။"
      ],
      "ar": [
        "أنت تراني.",
        "أنت تعرف اسمي."
      ]
    }
  },
  "hab": {
    "v": "2",
    "t": {
      "en": [
        "While I wait,",
        "you are my strength."
      ],
      "zh": [
        "在我等候时，",
        "你是我的力量。"
      ],
      "ja": [
        "待っている間も、",
        "あなたはわたしの力。"
      ],
      "my": [
        "ကျွန်ုပ် စောင့်နေစဉ်၊",
        "ကိုယ်တော်သည် ကျွန်ုပ်ခွန်အား ဖြစ်ပါတယ်။"
      ],
      "ar": [
        "وأنا أنتظر،",
        "أنت قوّتي."
      ]
    }
  },
  "hannah": {
    "v": "2",
    "t": {
      "en": [
        "You hear my heart.",
        "I can rest in you."
      ],
      "zh": [
        "你听见我的心。",
        "我可以在你里面安息。"
      ],
      "ja": [
        "あなたはわたしの心を聞いている。",
        "わたしはあなたの中で休める。"
      ],
      "my": [
        "ကိုယ်တော် ကျွန်ုပ်နှလုံးသားကို ကြားပါတယ်။",
        "ကိုယ်တော့်ထံမှာ ကျွန်ုပ် အနားယူနိုင်ပါတယ်။"
      ],
      "ar": [
        "أنت تسمع قلبي.",
        "أستطيع أن أستريح فيك."
      ]
    }
  },
  "mary": {
    "v": "32, 35",
    "t": {
      "en": [
        "Jesus, you are here.",
        "You weep with me."
      ],
      "zh": [
        "耶稣，你在这里。",
        "你与我一同哭泣。"
      ],
      "ja": [
        "イエスさま、あなたはここにいる。",
        "わたしと共に泣いてくださる。"
      ],
      "my": [
        "ယေရှု၊ ကိုယ်တော် ဒီမှာ ရှိပါတယ်။",
        "ကျွန်ုပ်နဲ့အတူ ငိုကြွေးပါတယ်။"
      ],
      "ar": [
        "يا يسوع، أنت هنا.",
        "أنت تبكي معي."
      ]
    }
  },
  "joseph": {
    "v": "20",
    "t": {
      "en": [
        "In every place,",
        "you were with me."
      ],
      "zh": [
        "无论在哪里，",
        "你都与我同在。"
      ],
      "ja": [
        "どこにいても、",
        "あなたは共にいてくださった。"
      ],
      "my": [
        "ဘယ်နေရာမှာပဲဖြစ်ဖြစ်၊",
        "ကိုယ်တော် ကျွန်ုပ်နဲ့အတူ ရှိခဲ့ပါတယ်။"
      ],
      "ar": [
        "في كل مكان،",
        "كنت معي."
      ]
    }
  },
  "samaritan": {
    "v": "15–16",
    "t": {
      "en": [
        "You made me whole.",
        "I give you thanks."
      ],
      "zh": [
        "你使我痊愈。",
        "我向你献上感谢。"
      ],
      "ja": [
        "あなたはわたしを癒してくださった。",
        "感謝をささげます。"
      ],
      "my": [
        "ကိုယ်တော် ကျွန်ုပ်ကို ကုသပေးခဲ့ပါတယ်။",
        "ကိုယ်တော့်ကို ကျေးဇူးတင်ပါတယ်။"
      ],
      "ar": [
        "أنت شفيتني.",
        "أقدّم لك الشكر."
      ]
    }
  },
  "elijah": {
    "v": "12",
    "t": {
      "en": [
        "In the stillness,",
        "you are near."
      ],
      "zh": [
        "在寂静中，",
        "你就在身边。"
      ],
      "ja": [
        "静けさの中で、",
        "あなたは近くにいる。"
      ],
      "my": [
        "တိတ်ဆိတ်ခြင်းထဲမှာ",
        "ကိုယ်တော် နီးကပ်စွာ ရှိပါတယ်။"
      ],
      "ar": [
        "في السكون،",
        "أنت قريب."
      ]
    }
  },
  "ps77": {
    "v": "1",
    "t": {
      "en": [
        "I cry to you,",
        "and you hear me."
      ],
      "zh": [
        "我向你呼求，",
        "你垂听我。"
      ],
      "ja": [
        "あなたに叫ぶと、",
        "あなたは聞いてくださる。"
      ],
      "my": [
        "ကိုယ်တော့်ကို ကျွန်ုပ် အော်ဟစ်ပါတယ်၊",
        "ကိုယ်တော် ကျွန်ုပ်ကို နားထောင်ပါတယ်။"
      ],
      "ar": [
        "أصرخ إليك،",
        "وأنت تسمعني."
      ]
    }
  },
  "ps13": {
    "v": "1, 5",
    "t": {
      "en": [
        "While I wait,",
        "I trust your love."
      ],
      "zh": [
        "在我等候时，",
        "我信靠你的慈爱。"
      ],
      "ja": [
        "待っている間も、",
        "あなたの愛を信頼します。"
      ],
      "my": [
        "ကျွန်ုပ် စောင့်နေစဉ်၊",
        "ကိုယ်တော့်မေတ္တာကို ယုံကြည်ပါတယ်။"
      ],
      "ar": [
        "وأنا أنتظر،",
        "أثق بمحبتك."
      ]
    }
  },
  "ps61": {
    "v": "2",
    "t": {
      "en": [
        "Far from home, I call.",
        "Lead me to the rock."
      ],
      "zh": [
        "远离家乡，我呼求你。",
        "领我到那磐石。"
      ],
      "ja": [
        "故郷を遠く離れて、呼びます。",
        "岩へと導いてください。"
      ],
      "my": [
        "အိမ်နဲ့ဝေးနေပြီး ကိုယ်တော့်ကို ခေါ်ပါတယ်။",
        "ကျောက်ဆောင်ဆီ ပို့ဆောင်ပါ။"
      ],
      "ar": [
        "بعيدًا عن الوطن أدعوك.",
        "اهدني إلى الصخرة."
      ]
    }
  },
  "ps62": {
    "v": "8",
    "t": {
      "en": [
        "I pour out my heart.",
        "You are my refuge."
      ],
      "zh": [
        "我向你倾心吐意。",
        "你是我的避难所。"
      ],
      "ja": [
        "心を注ぎ出します。",
        "あなたはわたしの避け所。"
      ],
      "my": [
        "ကျွန်ုပ် စိတ်နှလုံးကို သွန်းလောင်းပါတယ်။",
        "ကိုယ်တော်သည် ကျွန်ုပ်ခိုလှုံရာ ဖြစ်ပါတယ်။"
      ],
      "ar": [
        "أسكب قلبي.",
        "أنت ملجأي."
      ]
    }
  },
  "ps56": {
    "v": "8",
    "t": {
      "en": [
        "You count my wanderings.",
        "You keep my tears."
      ],
      "zh": [
        "你数算我的流离。",
        "你收存我的眼泪。"
      ],
      "ja": [
        "あなたはわたしのさすらいを数え、",
        "涙をたくわえてくださる。"
      ],
      "my": [
        "ကျွန်ုပ်လှည့်လည်ခြင်းကို ရေတွက်ပါတယ်။",
        "ကျွန်ုပ်မျက်ရည်ကို သိမ်းထားပါတယ်။"
      ],
      "ar": [
        "أنت تحصي تيهاني.",
        "أنت تحفظ دموعي."
      ]
    }
  },
  "ps139": {
    "v": "1",
    "t": {
      "en": [
        "You know me,",
        "and you hold me."
      ],
      "zh": [
        "你知道我，",
        "你扶持我。"
      ],
      "ja": [
        "あなたはわたしを知り、",
        "支えてくださる。"
      ],
      "my": [
        "ကိုယ်တော် ကျွန်ုပ်ကို သိပြီး",
        "ကိုင်ထားပါတယ်။"
      ],
      "ar": [
        "أنت تعرفني،",
        "وأنت تمسكني."
      ]
    }
  }
}
